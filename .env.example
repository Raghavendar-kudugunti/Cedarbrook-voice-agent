# --- LLM (OpenAI-compatible; default Groq) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# --- LiveKit (WebRTC + agent dispatch) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Pick an Indian English / Hindi voice in the Cartesia playground
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3

# Shared secret between the voice worker and the API (any long random string)
AGENT_INTERNAL_TOKEN=

# --- Langfuse (optional; one trace per call) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

CORS_ORIGINS=http://localhost:8000

# --- Tuning (defaults shown) ---
# MIN_ENDPOINT_S=0.3
# MAX_ENDPOINT_S=2.0
# MIN_INTERRUPT_S=0.2
# SILENCE_SECONDS=6
# MAX_CALL_SECONDS=300
# CLINIC_TODAY=2026-11-16      # pin "today" for demos/tests

# --- Cost estimate, INR per unit (blank = README defaults) ---
RATE_INR_STT_AUDIO_SECONDS=
RATE_INR_TTS_CHARACTERS=
RATE_INR_LLM_INPUT_TOKENS=
RATE_INR_LLM_OUTPUT_TOKENS=

# Use Google Gemini instead of Groq (key from aistudio.google.com). Leave unset for Groq.
# LLM_PROVIDER=google
# GOOGLE_API_KEY=
# LLM_MODEL=gemini-3.8-flash

# Rate limits (Groq free tier is 8k tokens/min): wait and retry instead of handing the call off.
# LLM_MAX_RETRY=5
# LLM_RETRY_S=2.5
# LLM_FAILS_BEFORE_TRANSFER=2      # turns in a row with no LLM answer before the front desk takes over
# PREEMPTIVE=1                     # start the LLM before the caller finishes (faster, more tokens; paid tier)
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b   # optional fallbacks (comma separated)
